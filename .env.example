BYG_ENV=development
DATABASE_URL=postgresql+psycopg://byg:byg@127.0.0.1:5432/beforeyougo
SECRET_KEY=replace-with-a-long-random-string
# Optional LLM configuration; deterministic fallback works without a key.
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional operator-configured ICS calendar feeds, comma separated
ICS_FEED_URLS=
ENABLE_SCHEDULER=true
SYNC_INTERVAL_HOURS=12
